{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-wardrobe.local/evals/style-optimization-review.schema.json",
  "title": "AI Wardrobe Style Optimization Human Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "dataset_version",
    "evaluator_version",
    "production_image_model",
    "reviewer_id",
    "scores",
    "hard_failure_codes"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^of_[a-z0-9_]+$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "evaluator_version": {
      "const": "optimization-human-rubric-v1.0.0"
    },
    "production_image_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Pseudonymous reviewer reference; never a name or contact detail."
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_fidelity",
        "body_fidelity",
        "pose_composition_fidelity",
        "background_lighting_fidelity",
        "unmentioned_garment_fidelity",
        "requested_change_quality",
        "artifact_quality"
      ],
      "properties": {
        "identity_fidelity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "body_fidelity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pose_composition_fidelity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "background_lighting_fidelity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "unmentioned_garment_fidelity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "requested_change_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "artifact_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "hard_failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "IDENTITY",
          "POSE_AND_COMPOSITION",
          "BACKGROUND_AND_LIGHTING",
          "UNMENTIONED_GARMENTS",
          "REQUESTED_CHANGES_ONLY",
          "VISUAL_ARTIFACT"
        ]
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}

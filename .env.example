AIW_ENVIRONMENT=local
AIW_DEBUG=true
AIW_LOG_LEVEL=INFO
AIW_SECRET_KEY=local-development-only-change-me
AIW_ACCESS_TOKEN_KEY=local-access-token-key-change-me-000000
AIW_IDENTITY_HMAC_KEY=local-identity-hmac-key-change-me
AIW_IDENTITY_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AIW_WECHAT_LOGIN_ENABLED=false
AIW_WECHAT_APP_ID=
AIW_WECHAT_APP_SECRET=
AIW_OPENAI_ENABLED=false
AIW_OPENAI_API_KEY=
AIW_OPENAI_BASE_URL=https://api.openai.com/v1
# 仅 local/test；可与 OpenAI 同时启用，提供本地诊断/Critic 和图片失败回退。
# 演示结果不代表真实 AI 诊断或图片编辑质量。
AIW_LOCAL_AI_ENABLED=false
AIW_DIAGNOSIS_PRIMARY_MODEL=gpt-5.6-terra
AIW_DIAGNOSIS_FALLBACK_MODEL=gpt-5.6-luna
AIW_DIAGNOSIS_TIMEOUT_SECONDS=20
AIW_DIAGNOSIS_COST_CEILING_MICROUNITS=100000
AIW_DIAGNOSIS_EXECUTION_LEASE_SECONDS=120
AIW_OPTIMIZATION_IMAGE_MODEL=gpt-image-2-2026-04-21
AIW_OPTIMIZATION_CRITIC_PRIMARY_MODEL=gpt-5.6-terra
AIW_OPTIMIZATION_CRITIC_FALLBACK_MODEL=gpt-5.6-luna
AIW_OPTIMIZATION_IMAGE_TIMEOUT_SECONDS=60
AIW_OPTIMIZATION_CRITIC_TIMEOUT_SECONDS=20
AIW_OPTIMIZATION_IMAGE_COST_CEILING_MICROUNITS=400000
AIW_OPTIMIZATION_CRITIC_COST_CEILING_MICROUNITS=100000
AIW_OPTIMIZATION_EXECUTION_LEASE_SECONDS=300
AIW_OPTIMIZATION_MAX_GENERATION_ATTEMPTS=2
AIW_AI_CANARY_PERCENTAGE=0
AIW_DIAGNOSIS_CANARY_MODEL=
AIW_OPTIMIZATION_IMAGE_CANARY_MODEL=
AIW_OPTIMIZATION_CRITIC_CANARY_MODEL=
AIW_SHARE_EXECUTION_LEASE_SECONDS=60
AIW_SHARE_TTL_DAYS=30
AIW_DELETION_EXECUTION_LEASE_SECONDS=300
AIW_MAX_JSON_BODY_BYTES=1048576
AIW_READINESS_TIMEOUT_SECONDS=2
AIW_OTEL_ENABLED=false
AIW_OTEL_SERVICE_NAME=ai-wardrobe-api
AIW_OTEL_EXPORTER_OTLP_ENDPOINT=
AIW_OTEL_SAMPLE_RATIO=0.2
AIW_OTEL_EXPORT_TIMEOUT_SECONDS=5
AIW_OTEL_METRICS_EXPORT_INTERVAL_SECONDS=30
AIW_COS_ENABLED=false
AIW_COS_REGION=ap-shanghai
AIW_COS_BUCKET=
AIW_COS_SECRET_ID=
AIW_COS_SECRET_KEY=
AIW_COS_SECURITY_TOKEN=
AIW_COS_UPLOAD_SECRET_ID=
AIW_COS_UPLOAD_SECRET_KEY=
AIW_COS_UPLOAD_SECURITY_TOKEN=
# 仅 local/test 可启用；与 COS 互斥，目录内容不会提交到 Git。
AIW_LOCAL_STORAGE_ENABLED=false
AIW_LOCAL_STORAGE_ROOT=../.local/object-storage
AIW_LOCAL_STORAGE_BASE_URL=http://localhost:8000
AIW_DATABASE_URL=postgresql+psycopg://ai_wardrobe:ai_wardrobe@localhost:5432/ai_wardrobe
AIW_REDIS_URL=redis://localhost:6379/0
AIW_RATE_LIMIT_ENABLED=false
AIW_RATE_LIMIT_IP_PER_MINUTE=300
AIW_RATE_LIMIT_USER_PER_MINUTE=120
AIW_RATE_LIMIT_COSTLY_PER_MINUTE=10
AIW_OUTBOX_WORKER_ID=outbox-local
AIW_OUTBOX_BATCH_SIZE=50
AIW_OUTBOX_LOCK_TIMEOUT_SECONDS=300
AIW_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
AIW_OUTBOX_MAX_ATTEMPTS=16
AIW_STALE_JOB_GRACE_SECONDS=600
AIW_STALE_JOB_BATCH_SIZE=50
AIW_STALE_JOB_REAP_INTERVAL_SECONDS=60
AIW_ORPHAN_UPLOAD_TTL_SECONDS=3600
AIW_ORPHAN_UPLOAD_CLEANUP_LEASE_SECONDS=900
AIW_ORPHAN_UPLOAD_CLEANUP_BATCH_SIZE=50
AIW_ORPHAN_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
AIW_CORS_ORIGINS=["http://localhost:5173"]
AIW_TRUSTED_PROXY_CIDRS=[]

POSTGRES_DB=ai_wardrobe
POSTGRES_USER=ai_wardrobe
POSTGRES_PASSWORD=ai_wardrobe
# 本机若已运行 PostgreSQL 或 Redis，改这两个值避开端口冲突，
# 并同步调整上面的 AIW_DATABASE_URL 与 AIW_REDIS_URL。
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# 本地容量护栏，同时让 Redis 内存水位告警具备明确分母。
REDIS_MAXMEMORY=256mb

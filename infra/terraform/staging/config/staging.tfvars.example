availability_zone = "ap-guangzhou-6"
standby_availability_zone = "ap-guangzhou-7"

# 必须替换为真实入口/负载均衡所在的精确私网 CIDR，禁止 0.0.0.0/0。
api_ingress_source_cidrs = ["10.32.0.0/20"]

# 必须替换为微信配置与 Web 管理端实际使用的 HTTPS Origin，禁止 *。
cos_allowed_origins = [
  "https://servicewechat.com",
  "https://staging.example.com",
]

# 两个既有 CAM Role 必须使用不同身份；这里只保存非敏感 Role ID。
cos_upload_role_id  = "replace-with-upload-role-id"
cos_runtime_role_id = "replace-with-runtime-role-id"

# 先通过腾讯云 Redis 可用区配置查询确认两个数字 ID，禁止猜测或复用同一可用区。
redis_replica_zone_ids = [100006, 100007]

# 先从目标地域 TKE/CVM 控制台或 API 查询当前可用版本、跨区均有库存的主/备用机型。
# 以下值仅展示格式，不代表账号或地域在执行时一定可售。
tke_cluster_version       = "1.30.0"
tke_node_instance_type    = "SA5.MEDIUM4"
tke_backup_instance_types = ["S5.MEDIUM4"]

# 使用既有 CVM SSH Key，节点不配置密码且不分配公网 IP。
tke_ssh_key_ids = ["skey-replace0001"]

# 封测默认分别限制节点 NAT 与公网 API CLB 为 20 Mbps；调高前必须复核成本与压测证据。
nat_eip_bandwidth_mbps  = 20
edge_clb_bandwidth_mbps = 20

# 密码不进入 tfvars。Plan 前通过受控 Secret 注入：
# export TF_VAR_postgresql_root_password='<16～32 位随机强密码>'
# export TF_VAR_redis_password='<12～16 位随机强密码>'

extra_tags = {
  cost_center = "mvp-closed-beta"
  owner       = "platform"
}
